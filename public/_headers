/*
  X-Robots-Tag: all
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com https://identity.netlify.com https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://www.google-analytics.com https://cloudflareinsights.com https://api.langflow.org https://*.supabase.co wss://*.supabase.co https://identity.netlify.com; frame-src 'self' https://giscus.app; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400


/*.css
  X-Robots-Tag: all
  Content-Type: text/css; charset=UTF-8
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *


/*.js
  X-Robots-Tag: all
  Content-Type: application/javascript; charset=UTF-8
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *


/_astro/*
  X-Robots-Tag: all
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *


/*.woff
  X-Robots-Tag: all
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  
/*.woff2
  X-Robots-Tag: all
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/images/*.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: all
  
/images/*.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=31536000, immutable
  
/images/*.jpeg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=31536000, immutable
  
/images/*.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=31536000, immutable
  
/images/*.gif
  Content-Type: image/gif
  Cache-Control: public, max-age=31536000, immutable

/images/uploads/*.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable
  
/images/uploads/*.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=31536000, immutable
  
/images/uploads/*.jpeg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=31536000, immutable
  
/images/uploads/*.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=31536000, immutable

/posts/*
  X-Robots-Tag: all
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Vary: User-Agent, Accept-Language

/
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept-Language
  
/sitemap-index.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: all

/sitemap-*.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: all

/rss.xml
  Content-Type: application/rss+xml; charset=UTF-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: all

/robots.txt
  Content-Type: text/plain; charset=UTF-8
  Cache-Control: public, max-age=86400
  X-Robots-Tag: all

/404
  X-Robots-Tag: noindex
  Cache-Control: no-cache

/404.html
  X-Robots-Tag: noindex
  Cache-Control: no-cache
