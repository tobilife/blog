// Astra DB 캐싱 서비스
import { Client } from '@datastax/astra-db-ts';

class AstraCacheService {
  constructor() {
    this.client = null;
    this.collection = null;
    this.initialized = false;
  }

  async initialize() {
    if (this.initialized) return;

    try {
      this.client = new Client({
        token: process.env.ASTRA_DB_TOKEN,
        endpoint: process.env.ASTRA_DB_ENDPOINT
      });

      this.collection = this.client.db().collection('chat_cache');
      this.initialized = true;
      console.log('AstraCacheService initialized');
    } catch (error) {
      console.error('Failed to initialize AstraCacheService:', error);
      throw error;
    }
  }

  // 캐시 키 생성 (쿼리 정규화)
  generateCacheKey(query, context = {}) {
    const normalizedQuery = query.toLowerCase().trim();
    const contextKey = context.isWeather ? 'weather' : context.needsSearch ? 'search' : 'general';
    return `${contextKey}:${normalizedQuery}`;
  }

  // 캐시 조회 (매우 빠름: 10-50ms)
  async get(query, context = {}) {
    try {
      await this.initialize();
      const key = this.generateCacheKey(query, context);
      
      const result = await this.collection.findOne({
        _id: key,
        expiresAt: { $gt: new Date() }
      });

      if (result) {
        // 인기도 증가 (비동기)
        this.incrementPopularity(key);
        return {
          response: result.response,
          metadata: result.metadata,
          cached: true
        };
      }
      
      return null;
    } catch (error) {
      console.error('Cache get error:', error);
      return null;
    }
  }

  // 캐시 저장
  async set(query, response, context = {}, ttl = 3600) {
    try {
      await this.initialize();
      const key = this.generateCacheKey(query, context);
      
      await this.collection.insertOne({
        _id: key,
        query: query,
        response: response,
        context: context,
        metadata: {
          complexity: context.complexity || 'simple',
          hasSearchResults: context.hasSearchResults || false,
          responseTime: context.responseTime || 0
        },
        popularity: 1,
        createdAt: new Date(),
        expiresAt: new Date(Date.now() + ttl * 1000)
      }, {
        upsert: true
      });

      console.log(`Cached response for: ${key}`);
    } catch (error) {
      console.error('Cache set error:', error);
    }
  }

  // 인기도 증가
  async incrementPopularity(key) {
    try {
      await this.collection.updateOne(
        { _id: key },
        { $inc: { popularity: 1 } }
      );
    } catch (error) {
      console.error('Popularity increment error:', error);
    }
  }

  // 자주 사용되는 질문 사전 로드
  async preloadFrequentQueries() {
    try {
      const frequentQueries = await this.collection
        .find({ popularity: { $gt: 5 } })
        .sort({ popularity: -1 })
        .limit(100)
        .toArray();

      const preloadCache = new Map();
      frequentQueries.forEach(item => {
        preloadCache.set(item._id, {
          response: item.response,
          metadata: item.metadata
        });
      });

      return preloadCache;
    } catch (error) {
      console.error('Preload error:', error);
      return new Map();
    }
  }
}

// 싱글톤 인스턴스
export const astraCacheService = new AstraCacheService();
