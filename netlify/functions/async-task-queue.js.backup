// 비동기 작업 큐 서비스
import { Client } from '@datastax/astra-db-ts';

class AsyncTaskQueue {
  constructor() {
    this.client = null;
    this.tasksCollection = null;
    this.resultsCollection = null;
  }

  async initialize() {
    if (this.client) return;

    this.client = new Client({
      token: process.env.ASTRA_DB_TOKEN,
      endpoint: process.env.ASTRA_DB_ENDPOINT
    });

    this.tasksCollection = this.client.db().collection('async_tasks');
    this.resultsCollection = this.client.db().collection('task_results');
  }

  // 작업 생성
  async createTask(query, userId, context = {}) {
    await this.initialize();
    
    const taskId = this.generateTaskId();
    const task = {
      _id: taskId,
      query: query,
      userId: userId,
      context: context,
      status: 'pending',
      createdAt: new Date(),
      expiresAt: new Date(Date.now() + 300000) // 5분 후 만료
    };

    await this.tasksCollection.insertOne(task);
    
    // 즉시 응답용 초기 결과 생성
    const initialResult = {
      _id: taskId,
      status: 'processing',
      initialResponse: this.generateQuickResponse(query),
      progress: 10,
      createdAt: new Date()
    };

    await this.resultsCollection.insertOne(initialResult);

    return {
      taskId: taskId,
      initialResponse: initialResult.initialResponse
    };
  }

  // 빠른 응답 생성
  generateQuickResponse(query) {
    const quickResponses = {
      greeting: "안녕하세요! 질문을 처리하고 있습니다. 잠시만 기다려주세요.",
      weather: "날씨 정보를 가져오고 있습니다...",
      search: "관련 정보를 검색하고 있습니다...",
      complex: "복잡한 질문이네요. 최적의 답변을 준비하고 있습니다..."
    };

    if (/안녕|반가|하이/.test(query)) return quickResponses.greeting;
    if (/날씨/.test(query)) return quickResponses.weather;
    if (/검색|찾아|알려/.test(query)) return quickResponses.search;
    
    return quickResponses.complex;
  }

  // 작업 상태 확인
  async checkTaskStatus(taskId) {
    await this.initialize();
    
    const result = await this.resultsCollection.findOne({ _id: taskId });
    
    if (!result) {
      return { status: 'not_found' };
    }

    return {
      status: result.status,
      progress: result.progress,
      response: result.finalResponse || result.initialResponse,
      chunks: result.chunks || []
    };
  }

  // 작업 결과 업데이트 (백그라운드에서 실행)
  async updateTaskResult(taskId, update) {
    await this.initialize();
    
    await this.resultsCollection.updateOne(
      { _id: taskId },
      { 
        $set: {
          ...update,
          updatedAt: new Date()
        }
      }
    );
  }

  // 작업 ID 생성
  generateTaskId() {
    return `task_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
  }
}

export const asyncTaskQueue = new AsyncTaskQueue();
