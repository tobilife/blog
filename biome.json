{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"ignore": [
			".astro/**/*",
			"src/**/*.css",
			"src/public/**/*",
			"dist/**/*",
			"node_modules/**/*",
			"**/*.min.js",
			"**/*.min.css",
			"**/vendor/**/*",
			"**/*.generated.*",
			"**/*.md",
			"**/*.mdx"
		]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120,
		"lineEnding": "lf",
		"ignore": [
			"**/*.md",
			"**/*.mdx",
			"**/*.json",
			"**/*.svelte"
		]
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noForEach": "error",
				"useOptionalChain": "error",
				"useFlatMap": "warn"
			},
			"style": {
				"noNegationElse": "warn",
				"noUselessElse": "error",
				"useForOf": "error",
				"useTemplate": "warn"
			},
			"suspicious": {
				"noAssignInExpressions": "error",
				"noConsoleLog": "warn",
				"noDebugger": "error",
				"noDoubleEquals": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "always",
			"bracketSpacing": true,
			"bracketSameLine": false
		}
	},
	"overrides": [
		{
			"include": ["*.svelte", "*.astro", "*.vue"],
			"linter": {
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off"
					}
				}
			},
			"formatter": {
				"formatWithErrors": true,
				"lineWidth": 150
			}
		},
		{
			"include": ["**/*.json", "**/*.jsonc"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		},
		{
			"include": ["**/*.js", "**/*.ts"],
			"formatter": {
				"lineWidth": 120
			}
		}
	]
}
