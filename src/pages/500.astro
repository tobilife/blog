---
import Layout from "../layouts/Layout.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";

export const prerender = true;
---

<Layout 
  title="500 - Server Error" 
  description="서버 오류가 발생했습니다. 잠시 후 다시 시도해주세요."
>
  <MainGridLayout>
    <div class="flex flex-col justify-center items-center min-h-[60vh] text-center px-4">
      <h1 class="text-6xl font-bold text-primary mb-4">500</h1>
      <h2 class="text-2xl font-semibold mb-4">서버 오류</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-md">
        죄송합니다. 서버에서 오류가 발생했습니다.<br />
        잠시 후 다시 시도해주세요.
      </p>
      <div class="flex gap-4">
        <a 
          href="/" 
          class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary-hover transition-colors"
        >
          홈으로 돌아가기
        </a>
        <button 
          onclick="window.location.reload()" 
          class="px-6 py-2 border border-primary text-primary rounded-lg hover:bg-primary/10 transition-colors"
        >
          새로고침
        </button>
      </div>
    </div>
  </MainGridLayout>
</Layout>
