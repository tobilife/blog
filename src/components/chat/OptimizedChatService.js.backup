// 개선된 챗봇 서비스 (Astra DB 통합)
export class OptimizedChatService {
  constructor() {
    this.baseUrl = '/.netlify/functions';
    this.pollingInterval = null;
  }

  async sendMessage(message, options = {}) {
    const startTime = Date.now();
    
    try {
      // 1. 먼저 동기 모드로 시도
      const response = await fetch(`${this.baseUrl}/langflow-proxy-astra`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          input_value: message,
          userId: options.userId || 'anonymous',
          mode: 'sync',
          conversation_history: options.conversationHistory || []
        })
      });

      const data = await response.json();
      
      // 2. 타임아웃 또는 복잡한 질문인 경우 비동기 모드 전환
      if (response.status === 504 || data.suggestedMode === 'async') {
        console.log('Switching to async mode');
        return await this.sendAsyncMessage(message, options);
      }
      
      // 3. 캐시 히트인 경우 즉시 반환
      if (response.headers.get('X-Cache') === 'HIT') {
        console.log('Cache hit! Response time:', Date.now() - startTime, 'ms');
        return {
          success: true,
          response: data.response || data,
          cached: true,
          responseTime: Date.now() - startTime
        };
      }
      
      // 4. 일반 응답
      return {
        success: true,
        response: data,
        cached: false,
        responseTime: Date.now() - startTime
      };
      
    } catch (error) {
      console.error('Chat service error:', error);
      
      // 5. 에러 시 비동기 모드로 폴백
      if (Date.now() - startTime > 8000) {
        return await this.sendAsyncMessage(message, options);
      }
      
      throw error;
    }
  }

  async sendAsyncMessage(message, options = {}) {
    try {
      // 1. 비동기 작업 생성
      const response = await fetch(`${this.baseUrl}/langflow-proxy-astra`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          input_value: message,
          userId: options.userId || 'anonymous',
          mode: 'async',
          conversation_history: options.conversationHistory || []
        })
      });

      const data = await response.json();
      
      if (data.taskId) {
        // 2. 초기 응답 표시
        if (options.onInitialResponse) {
          options.onInitialResponse(data.initialResponse);
        }
        
        // 3. 폴링 시작
        return await this.pollForResult(data.taskId, options);
      }
      
      return {
        success: false,
        error: 'Failed to create async task'
      };
      
    } catch (error) {
      console.error('Async message error:', error);
      throw error;
    }
  }

  async pollForResult(taskId, options = {}) {
    const maxPolls = 30; // 최대 30번 폴링 (30초)
    const pollInterval = 1000; // 1초마다
    let pollCount = 0;
    
    return new Promise((resolve, reject) => {
      this.pollingInterval = setInterval(async () => {
        try {
          pollCount++;
          
          // 상태 확인
          const response = await fetch(
            `${this.baseUrl}/check-task-status?taskId=${taskId}`
          );
          const status = await response.json();
          
          // 진행 상황 업데이트
          if (options.onProgress && status.progress) {
            options.onProgress(status.progress);
          }
          
          // 완료된 경우
          if (status.status === 'completed' || status.response) {
            clearInterval(this.pollingInterval);
            resolve({
              success: true,
              response: status.response,
              async: true
            });
          }
          
          // 청크 업데이트
          if (status.chunks && status.chunks.length > 0 && options.onChunk) {
            status.chunks.forEach(chunk => options.onChunk(chunk));
          }
          
          // 최대 폴링 횟수 초과
          if (pollCount >= maxPolls) {
            clearInterval(this.pollingInterval);
            reject(new Error('Polling timeout'));
          }
          
        } catch (error) {
          clearInterval(this.pollingInterval);
          reject(error);
        }
      }, pollInterval);
    });
  }

  stopPolling() {
    if (this.pollingInterval) {
      clearInterval(this.pollingInterval);
      this.pollingInterval = null;
    }
  }
}

// 사용 예시
const chatService = new OptimizedChatService();

// 동기/비동기 자동 전환
const result = await chatService.sendMessage('GitHub 트렌드 검색해줘', {
  userId: 'user123',
  onInitialResponse: (response) => {
    console.log('초기 응답:', response);
  },
  onProgress: (progress) => {
    console.log('진행률:', progress + '%');
  },
  onChunk: (chunk) => {
    console.log('청크 수신:', chunk);
  }
});
