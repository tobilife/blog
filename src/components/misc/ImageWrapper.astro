---
import path from "node:path";
interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "lazy" | "eager";
	widths?: number[];
	sizes?: string;
	formats?: Array<"webp" | "jpg" | "png">;
}
import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	loading = "lazy",
	widths = [320, 640, 768, 1024, 1200],
	sizes = "(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 1200px",
	formats = ["webp"],
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(src.startsWith("/") || src.startsWith("http") || src.startsWith("https") || src.startsWith("data:"));
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <explanation>
let img;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	let normalizedPath = path.normalize(path.join("../../", basePath, src)).replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`);
	}
	img = await file();
}

const imageClass = "w-full h-full object-contain md:object-cover";
const imageStyle = `object-position: ${position}`;

// 이미지 메타데이터 설정
const imageAlt = alt || src.split("/").pop()?.split(".")[0] || "";
---
<div id={id} class:list={[className, 'overflow-hidden relative image-wrapper']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {isLocal && img && (
		<Image 
			src={img} 
			alt={imageAlt} 
			class={imageClass} 
			style={imageStyle} 
			loading={loading}
			widths={widths}
			sizes={sizes}
			formats={formats}
			quality={85}
			decoding="async"
		/>
	)}
    {!isLocal && (
		<img 
			src={isPublic ? url(src) : src} 
			alt={imageAlt} 
			class={imageClass} 
			style={imageStyle} 
			loading={loading}
			decoding="async"
			fetchpriority={loading === "eager" ? "high" : "low"}
		/>
	)}
</div>

<style>
	.image-wrapper {
		background-color: var(--card-bg);
		aspect-ratio: 16 / 9;
	}
	
	@media (max-width: 640px) {
		.image-wrapper {
			aspect-ratio: 4 / 3;
		}
	}
	
	/* 이미지 로딩 중 스켈레톤 */
	.image-wrapper::before {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			var(--card-bg) 0%,
			var(--btn-regular-bg) 50%,
			var(--card-bg) 100%
		);
		background-size: 200% 100%;
		animation: skeleton 1.5s ease-in-out infinite;
		z-index: -1;
	}
	
	@keyframes skeleton {
		0% {
			background-position: 200% 0;
		}
		100% {
			background-position: -200% 0;
		}
	}
	
	/* 이미지 로드 완료 시 스켈레톤 숨기기 */
	.image-wrapper img {
		z-index: 1;
	}
</style>
