---
export interface Props {
	title: string;
	description: string;
	image?: string;
	canonical?: string;
	type?: "website" | "article";
	publishedTime?: string;
	modifiedTime?: string;
	tags?: string[];
	author?: string;
	lang?: string;
	noindex?: boolean;
	nofollow?: boolean;
}

const {
	title,
	description,
	image = "/images/default-og.png",
	canonical,
	type = "website",
	publishedTime,
	modifiedTime,
	tags = [],
	author = "토비라이프",
	lang = "ko-KR",
	noindex = false,
	nofollow = false,
} = Astro.props;

const siteUrl = Astro.site || "https://tobilife.netlify.app";
const fullImageUrl = image.startsWith("http") ? image : `${siteUrl}${image}`;
const canonicalUrl = canonical || Astro.url.href;

// robots meta content 생성
const robotsContent = [
	noindex ? "noindex" : "index",
	nofollow ? "nofollow" : "follow",
	"max-image-preview:large",
	"max-snippet:-1",
	"max-video-preview:-1",
].join(", ");

// 언어 코드 처리
const langCode = lang.split("-")[0];
const localeCode = lang.replace("-", "_");

// 기본 이미지 크기 설정
const imageWidth = image === "/images/default-og.png" ? "1200" : "1200";
const imageHeight = image === "/images/default-og.png" ? "630" : "630";
const imageType = fullImageUrl.includes(".webp") ? "image/webp" : "image/png";
---

<!-- Essential Meta Tags (최우선 순위) -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />

<!-- Preconnect for Performance -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- Canonical and Language -->
<link rel="canonical" href={canonicalUrl} />
<meta http-equiv="Content-Language" content={langCode} />
<meta name="language" content={langCode} />

<!-- Open Graph Tags (소셜 미디어 공유 최적화) -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="토비라이프 블로그" />
<meta property="og:locale" content={localeCode} />

<!-- Open Graph Image with Dimensions -->
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content={imageWidth} />
<meta property="og:image:height" content={imageHeight} />
<meta property="og:image:type" content={imageType} />
<meta property="og:image:alt" content={title} />

{type === "article" && (
	<>
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		<meta property="article:author" content={author} />
		{tags.map((tag) => (
			<meta property="article:tag" content={tag} />
		))}
	</>
)}

<!-- Twitter Card Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content={title} />

<!-- SEO Meta Tags -->
<meta name="author" content={author} />
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />
{tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}

<!-- Mobile Web App -->
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="토비라이프" />

<!-- Theme Color -->
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />
<meta name="msapplication-TileColor" content="#ffffff" />

<!-- Additional Performance and SEO -->
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="generator" content={Astro.generator} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<!-- Alternate Language Links -->
<link rel="alternate" hreflang={langCode} href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

<!-- Structured Data for Website -->
{type === "website" && (
	<script type="application/ld+json">
		{JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "토비라이프 블로그",
			"alternateName": "TobiLife Blog",
			"url": siteUrl,
			"potentialAction": {
				"@type": "SearchAction",
				"target": {
					"@type": "EntryPoint",
					"urlTemplate": `${siteUrl}/search?q={search_term_string}`
				},
				"query-input": "required name=search_term_string"
			},
			"author": {
				"@type": "Person",
				"name": author,
				"url": `${siteUrl}/about/`
			},
			"description": description,
			"inLanguage": lang
		})}
	</script>
)}
